<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         cacheDirectory=".phpunit.cache"
         colors="true"
         processIsolation="false"
         stopOnFailure="false">

    <testsuites>
        <testsuite name="JmaXml">
            <directory suffix="Test.php">packages/*/tests/</directory>
            <directory suffix="Test.php">tools/codegen/tests/</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>live</group>
        </exclude>
    </groups>

    <source>
        <include>
            <directory suffix=".php">packages/*/src/</directory>
        </include>
    </source>
</phpunit>
