{
    "name": "shimomo/jmaxml-php",
    "description": "Unofficial PHP libraries for JMA (Japan Meteorological Agency) disaster information XML",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "yuichi@shimomo.net"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "laravel/pint": "^1.27",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^13.2",
        "symfony/http-client": "^8.0",
        "vimeo/psalm": "^6.0"
    },
    "replace": {
        "jmaxml/codes": "self.version",
        "jmaxml/core": "self.version",
        "jmaxml/feed": "self.version"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "canonical": false,
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "JmaXml\\": "packages/core/src/",
            "JmaXml\\Codes\\": "packages/codes/src/",
            "JmaXml\\Feed\\": "packages/feed/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JmaXml\\Codegen\\": "tools/codegen/src/",
            "JmaXml\\Codegen\\Tests\\": "tools/codegen/tests/",
            "JmaXml\\Codes\\Tests\\": "packages/codes/tests/",
            "JmaXml\\Feed\\Tests\\": "packages/feed/tests/",
            "JmaXml\\Tests\\": "packages/core/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "analyse": "psalm",
        "fix": "pint",
        "generate": "php tools/codegen/bin/generate",
        "lint": "pint --test",
        "test": "phpunit"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
